{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. Entraîner PPO sur Pendulum-v1",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train_ppo.py",
            "console": "integratedTerminal",
            "args": [
                "--total-timesteps", "150000",
                "--eval-freq", "5000"
            ]
        },
        {
            "name": "2. Évaluer & Visualiser PPO (Pendulum-v1)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/evaluate_ppo.py",
            "console": "integratedTerminal",
            "args": [
                "--render",
                "--episodes", "5"
            ]
        }
    ]
}
