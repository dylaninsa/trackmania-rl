{
    "env": "Pendulum-v1",
    "seed": 0,
    "total_steps": 150000,
    "buffer_size": 2048,
    "ep_max_length": 200,
    "batch_size": 64,
    "ppo_epochs": 10,
    "eval_every": 5000,
    "eval_episodes": 10,
    "hidden": 64,
    "lr_actor": 0.001,
    "lr_critic": 0.002,
    "min_lr_fraction": 0.05,
    "gamma": 0.95,
    "gae_lambda": 0.95,
    "clip_eps": 0.2,
    "entropy_coef": 0.0,
    "value_coef": 0.5,
    "max_grad_norm": 0.5,
    "normalize_states": true,
    "reward_scale": 0.1,
    "device": "cpu"
}
