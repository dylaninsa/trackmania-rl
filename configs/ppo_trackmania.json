{
    "env": "trackmania",
    "seed": 0,
    "total_steps": 200000,
    "buffer_size": 4096,
    "ep_max_length": 3000,
    "batch_size": 256,
    "ppo_epochs": 10,
    "eval_every": 20000,
    "eval_episodes": 3,
    "hidden": 256,
    "lr_actor": 0.0003,
    "lr_critic": 0.001,
    "min_lr_fraction": 0.1,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_eps": 0.2,
    "entropy_coef": 0.001,
    "value_coef": 0.5,
    "max_grad_norm": 0.5,
    "normalize_states": false,
    "reward_scale": 1.0,
    "device": "cpu"
}
